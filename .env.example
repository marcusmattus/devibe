# GitHub OAuth (enables sign-in and repo access)
EXPO_PUBLIC_GITHUB_CLIENT_ID=d4ab3bdc49967a7282bb1c0560db28813ccceabc

# Optional — OAuth authorization code fallback (requires redirect URI registered on GitHub)
# Enable Device Flow on your OAuth app instead for mobile-only sign-in without a client secret.
# EXPO_PUBLIC_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Stripe Connect (optional — enables Stripe OAuth)
EXPO_PUBLIC_STRIPE_CLIENT_ID=your_stripe_connect_client_id
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
